      value: This temple is dedicated to Chaac.
      objectReference: {fileID: 0}
    - target: {fileID: 5668456217277715989, guid: 8bfd9d78d6dff414fbceadccb912c611, type: 3}
      propertyPath: 'textLines.Array.data[1]'
      value: He brings rain upon us if we are worthy!
